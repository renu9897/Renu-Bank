<!DOCTYPE html>
<html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Portal Follow - Renu</title>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js"></script>
<style>
body{margin:0;background:#000;overflow:hidden}
#video{display:none}
#canvas{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
#msg{position:absolute;top:10px;width:100%;text-align:center;color:yellow;font:700 18px sans-serif;z-index:10}
#recBtn{position:absolute;bottom:15px;left:50%;transform:translateX(-50%);background:red;color:#fff;border:0;padding:12px 24px;border-radius:99px;z-index:10}
</style>
</head><body>
<video id="video" autoplay playsinline muted></video>
<canvas id="canvas"></canvas>
<div id="msg">Dono haath dikhao...</div>
<button id="recBtn">🔴 Record</button>
<script>
const video=document.getElementById('video'),canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d');
canvas.width=innerWidth;canvas.height=innerHeight;
const hands=new Hands({locateFile:f=>`https://cdn.jsdelivr.net/npm/@mediapipe/hands@0.4.1675469240/${f}`});
hands.setOptions({maxNumHands:2,modelComplexity:1,minDetectionConfidence:0.6,minTrackingConfidence:0.6});
hands.onResults(r=>{
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.drawImage(video,0,0,canvas.width,canvas.height);
  if(r.multiHandLandmarks){
    r.multiHandLandmarks.forEach((lm,i)=>{
      let x=lm[9].x*canvas.width, y=lm[9].y*canvas.height;
      let color = i==0? '#00e5ff' : '#ffeb3b';
      for(let k=0;k<3;k++){
        ctx.shadowColor=color; ctx.shadowBlur=20+k*8; ctx.strokeStyle=color; ctx.lineWidth=5-k;
        ctx.beginPath(); ctx.arc(x,y,50+k*3,0,Math.PI*2); ctx.stroke();
      }
      ctx.shadowBlur=0;
    });
  }
});
(async()=>{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'}});video.srcObject=s;
const cam=new Camera(video,{onFrame:async()=>await hands.send({image:video}),width:640,height:480});cam.start();})();
let rec,chunks=[];recBtn.onclick=function(){
  if(rec&&rec.state=='recording'){rec.stop();this.textContent='🔴 Record';}
  else{let st=canvas.captureStream(30);rec=new MediaRecorder(st);chunks=[];rec.ondataavailable=e=>chunks.push(e.data);
  rec.onstop=()=>{let b=new Blob(chunks,{type:'video/webm'});let a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='portal-move.webm';a.click();};rec.start();this.textContent='⏹️ Stop';}
};
</script></body></html>