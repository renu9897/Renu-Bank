import json
import os
from datetime import datetime

FILE_NAME = "balance.txt"
PIN_FILE = "pin.txt"
HISTORY_FILE = "history.txt"
DEFAULT_PIN = "1234"

def load_pin():
    if not os.path.exists(PIN_FILE):
        with open(PIN_FILE, "w") as f:
            f.write(DEFAULT_PIN)
    with open(PIN_FILE, "r") as f:
        return f.read().strip()

def save_pin(new_pin):
    with open(PIN_FILE, "w") as f:
        f.write(new_pin)

def load_balance():
    if not os.path.exists(FILE_NAME):
        with open(FILE_NAME, "w") as f:
            f.write("0")
    with open(FILE_NAME, "r") as f:
        return int(f.read().strip())

def save_balance(balance):
    with open(FILE_NAME, "w") as f:
        f.write(str(balance))

def save_history(action, amount, balance):
    time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(HISTORY_FILE, "a") as f:
        f.write(f"{time} | {action} | Rs.{amount} | Balance: Rs.{balance}\n")

def show_history():
    if not os.path.exists(HISTORY_FILE):
        print("Abhi tak koi transaction nahi hua")
        return
    print("\n--- Transaction History ---")
    with open(HISTORY_FILE, "r") as f:
        print(f.read())

def change_pin():
    old_pin = input("Purana PIN dalo: ")
    if old_pin != load_pin():
        print("Galat PIN!")
        return
    new_pin = input("Naya PIN dalo: ")
    confirm = input("Phir se PIN dalo: ")
    if new_pin == confirm:
        save_pin(new_pin)
        print("PIN successfully change ho gaya!")
    else:
        print("PIN match nahi kiya")

def main():
    pin = input("PIN dalo: ")
    if pin != load_pin():
        print("Galat PIN! Access Denied")
        return
    
    balance = load_balance()
    while True:
        print("\n1. Deposit\n2. Withdraw\n3. Check Balance\n4. History\n5. Change PIN\n6. Exit")
        choice = input("Choice: ")
        
        if choice == "1":
            amt = int(input("Kitna deposit karna hai: "))
            balance += amt
            save_balance(balance)
            save_history("Deposit", amt, balance)
            print(f"Deposit ho gaya. Balance: {balance}")
        
        elif choice == "2":
            amt = int(input("Kitna withdraw karna hai: "))
            if amt <= balance:
                balance -= amt
                save_balance(balance)
                save_history("Withdraw", amt, balance)
                print(f"Withdraw ho gaya. Balance: {balance}")
            else:
                print("Paise kam hai!")
        
        elif choice == "3":
            print(f"Balance: Rs.{balance}")
        
        elif choice == "4":
            show_history()
        
        elif choice == "5":
            change_pin()
        
        elif choice == "6":
            print("Thank you!")
            break

if __name__ == "__main__":
    main()